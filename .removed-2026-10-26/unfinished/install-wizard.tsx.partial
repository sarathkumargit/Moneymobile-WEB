"use client";
import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { Usb, QrCode, Download, CheckCircle2, AlertCircle, Loader2, Smartphone, Wifi, RefreshCw } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

// Three ways to put MoneyMobile on a phone — if one doesn't work, use another:
//   1. USB from this browser (Chrome/Edge, WebUSB) — no downloads, no terminal.
//   2. QR code — new / factory-reset phone, no computer or cable at all.
//   3. Download kit — the Windows / Mac setup file (works everywhere).

type Config = {
  shopId: string; shopName: string | null; secret: string; serverUrl: string; apkUrl: string;
  fromLocalhost: boolean; apk: { size: number; built: string; checksum: string } | null;
};
type Toolkit = {
  usbSupported(): boolean;
  connectPhone(): Promise<Phone | null>;
  shell(adb: unknown, cmd: string): Promise<string>;
  installApk(adb: unknown, bytes: Uint8Array, onProgress?: (f: number) => void): Promise<void>;
  disconnect(p: Phone | null): Promise<void>;
  qrSvg(text: string, cellSize?: number): string;
};
type Phone = { adb: unknown; serial: string; model: string; manufacturer: string; android: string };
type Tab = "usb" | "qr" | "kit";

const PKG = "com.moneymobile.installment";
const ADMIN = `${PKG}/.admin.DeviceAdminReceiver`;
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

function useToolkit() {
  const [tk, setTk] = useState<Toolkit | null>(null);
  const [err, setErr] = useState<string | null>(null);
  useEffect(() => {
    // Served from /public/vendor — bundled ADB-over-WebUSB + QR code generator.
    import(/* webpackIgnore: true */ "/vendor/mm-toolkit.js" as string)
      .then((m) => setTk(m as Toolkit))
      .catch((e) => setErr(`Could not load the setup tools: ${e?.message ?? e}`));
  }, []);
  return { tk, err };
}

export function InstallWizard({ kitCards }: { kitCards: React.ReactNode }) {
  const [tab, setTab] = useState<Tab>("usb");
  const [cfg, setCfg] = useState<Config | null>(null);
  const [cfgErr, setCfgErr] = useState<string | null>(null);
  const { tk, err: tkErr } = useToolkit();

  useEffect(() => {
    fetch("/api/setup-kit/config", { cache: "no-store" })
      .then(async (r) => { const j = await r.json(); if (!r.ok) throw new Error(j.error || r.statusText); setCfg(j); })
      .catch((e) => setCfgErr(String(e.message ?? e)));
  }, []);

  const tabs: { id: Tab; label: string; icon: typeof Usb; hint: string }[] = [
    { id: "usb", label: "USB from this browser", icon: Usb, hint: "Chrome / Edge · no downloads" },
    { id: "qr", label: "QR code", icon: QrCode, hint: "New or reset phone · no computer" },
    { id: "kit", label: "Download setup file", icon: Download, hint: "Windows / Mac · always works" },
  ];

  return (
    <div className="space-y-4">
      <div className="grid gap-2 sm:grid-cols-3">
        {tabs.map((t) => (
          <button key={t.id} type="button" onClick={() => setTab(t.id)}
            className={`flex items-start gap-3 rounded-xl border p-4 text-left transition-colors ${tab === t.id ? "border-primary bg-primary/5 ring-1 ring-primary" : "bg-card hover:bg-muted/50"}`}>
            <t.icon className={`mt-0.5 h-5 w-5 ${tab === t.id ? "text-primary" : "text-muted-foreground"}`} />
            <span><span className="block text-sm font-semibold">{t.label}</span><span className="block text-xs text-muted-foreground">{t.hint}</span></span>
          </button>
        ))}
      </div>
      {cfgErr && <Notice tone="error">{cfgErr}</Notice>}
      {tkErr && tab !== "kit" && <Notice tone="error">{tkErr}</Notice>}
      {tab === "usb" && <UsbSetup tk={tk} cfg={cfg} onFallback={setTab} />}
      {tab === "qr" && <QrSetup tk={tk} cfg={cfg} onFallback={setTab} />}
      {tab === "kit" && kitCards}
    </div>
  );
}

function Notice({ tone, children }: { tone: "error" | "info" | "ok" | "warn"; children: React.ReactNode }) {
  const cls = {
    error: "border-red-200 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300",
    info: "border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-300",
    ok: "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300",
    warn: "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300",
  }[tone];
  const Icon = tone === "ok" ? CheckCircle2 : AlertCircle;
  return <div className={`flex items-start gap-2 rounded-lg border px-3 py-2 text-sm ${cls}`}><Icon className="mt-0.5 h-4 w-4 shrink-0" /><div>{children}</div></div>;
}

// ───────────────────────────── USB (WebUSB) ─────────────────────────────

type Step = { label: string; state: "todo" | "run" | "ok" | "fail"; detail?: string };
const USB_STEPS = ["Connect to the phone", "Install the MoneyMobile app", "Enable full management (Device Owner)", "Register the phone with the shop"];

function UsbSetup({ tk, cfg, onFallback }: { tk: Toolkit | null; cfg: Config | null; onFallback: (t: Tab) => void }) {
  const [steps, setSteps] = useState<Step[]>(USB_STEPS.map((label) => ({ label, state: "todo" })));
  const [busy, setBusy] = useState(false);
  const [result, setResult] = useState<{ tone: "ok" | "error" | "warn"; text: React.ReactNode } | null>(null);
  const [phoneName, setPhoneName] = useState<string | null>(null);
  const [progress, setProgress] = useState<number | null>(null);
  const phoneRef = useRef<Phone | null>(null);

  const secure = typeof window !== "undefined" ? window.isSecureContext : true;
  const supported = !!tk?.usbSupported();
  const set = (i: number, state: Step["state"], detail?: string) => setSteps((s) => s.map((x, j) => (j === i ? { ...x, state, detail } : x)));

  const run = useCallback(async () => {
    if (!tk || !cfg) return;
    setBusy(true); setResult(null); setPhoneName(null); setProgress(null);
    setSteps(USB_STEPS.map((label) => ({ label, state: "todo" })));
    let i = 0;
    try {
      // 1. connect
      set(0, "run", "Choose the phone in the browser's list, then tap Allow on the phone (tick \"Always allow\").");
      const phone = await tk.connectPhone();
      if (!phone) { set(0, "todo"); setBusy(false); return; }
      

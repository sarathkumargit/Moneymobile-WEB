# ─── Supabase ───────────────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose in client code or commit. (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Firebase Cloud Messaging (push to phones) ──────────────
# Local dev: put the service-account JSON in a file named firebase-service-account.json
#   at the project root (git-ignored) — no env var needed.
# Hosted (Vercel/Railway): there's no file, so paste the WHOLE service-account JSON as ONE line here.
#   Firebase console → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}
